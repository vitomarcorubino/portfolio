---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

const CV_URL = '/cv/cv-vito-marco-rubino-en.pdf';
const LINKEDIN_URL = 'https://www.linkedin.com/in/vitomarcorubino';
const EMAIL = 'rubino.vitomarcorubino@gmail.com';

const experience = (await getCollection('experience')).sort((a, b) =>
  (b.data.startDate ?? '').localeCompare(a.data.startDate ?? '')
);

const education = (await getCollection('education')).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate)
);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Converte "2026-07" in "lug 2026"
function formatMonth(value: string) {
  if (!value) return '';
  return new Date(`${value}-01T00:00:00Z`).toLocaleDateString('it-IT', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Layout title="Vito Marco Rubino" description="AI Engineer & Data Scientist">
  <section class="py-20">
    <h1 class="text-4xl font-bold md:text-5xl">Ciao, sono Vito Marco Rubino.</h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-400">
      Tra non molto troverai qui il mio portfolio completo. Intanto sto costruendo...
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a href={CV_URL} download class="rounded-lg bg-white px-5 py-3 font-semibold text-slate-900 hover:bg-slate-200">
        Scarica il CV
      </a>
      <a href={`mailto:${EMAIL}`} class="rounded-lg border border-slate-600 px-5 py-3 font-semibold hover:bg-slate-800">
        Scrivimi
      </a>
      <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-slate-600 px-5 py-3 font-semibold hover:bg-slate-800">
        LinkedIn
      </a>
    </div>
  </section>

  <section id="esperienza" class="py-16">
    <h2 class="mb-12 text-3xl font-bold">Esperienza</h2>

    <ol class="relative border-l border-slate-700 pl-10">
      {experience.map((item, index) => {
        const isCurrent = !item.data.endDate;
        const end = isCurrent ? 'Presente' : formatMonth(item.data.endDate!);
        return (
          <li class="relative mb-12">
            <span
              class={`absolute -left-10 top-2 h-3.5 w-3.5 rounded-full border-2 border-slate-950 ${
                index === 0 && isCurrent ? 'bg-emerald-400' : 'bg-slate-500'
              }`}
            ></span>
            <p class="text-sm text-slate-500">
              {formatMonth(item.data.startDate)} – {end}
            </p>
            <h3 class="mt-1 text-xl font-semibold">{item.data.role}</h3>
            <p class="text-slate-400">
              {item.data.company} · {item.data.location}
            </p>
            <div
  class="mt-3 max-w-2xl text-slate-300 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 [&_p]:mb-2 [&_strong]:font-semibold [&_strong]:text-white [&_em]:italic"
  set:html={marked.parse(item.data.descriptionIt ?? '', { async: false })}
/>
          </li>
        );
      })}
    </ol>
  </section>

  <section id="formazione" class="py-16">
  <h2 class="mb-12 text-3xl font-bold">Formazione</h2>

  <ol class="space-y-6">
    {education.map((item) => (
      <li class="rounded-lg border border-slate-800 p-6">
        <p class="text-sm text-slate-500">
          {formatMonth(item.data.startDate)} – {formatMonth(item.data.endDate)}
        </p>
        <h3 class="mt-1 text-xl font-semibold">{item.data.degree}</h3>
        <p class="text-slate-400">
          {item.data.institution} · {item.data.location}
        </p>
        <p class="mt-3 text-slate-300">
          Voto: <span class="font-semibold text-white">{item.data.grade}</span>
        </p>
        {item.data.thesis && (
          <p class="mt-2 text-slate-300">
            <span class="text-slate-500">Tesi:</span> <em>{item.data.thesis}</em>
          </p>
        )}
      </li>
    ))}
  </ol>
</section>

<section id="progetti" class="py-16">
  <h2 class="mb-12 text-3xl font-bold">Progetti</h2>

  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((item) => (
      <article class="flex flex-col rounded-lg border border-slate-800 p-6">
        <p class="text-sm text-slate-500">{item.data.period}</p>
        <p class="mt-2 text-3xl font-bold text-emerald-400">{item.data.metric}</p>
        <h3 class="mt-3 text-xl font-semibold">{item.data.title}</h3>
        <div
          class="mt-3 flex-1 text-slate-300 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 [&_p]:mb-2 [&_strong]:font-semibold [&_strong]:text-white [&_em]:italic"
          set:html={marked.parse(item.data.summaryIt ?? '', { async: false })}
        ></div>
        <p class="mt-4 text-sm text-slate-500">{item.data.stack}</p>
        <div class="mt-4 flex gap-4 text-sm">
          {item.data.repo && (
            <a href={item.data.repo} target="_blank" rel="noopener noreferrer" class="underline hover:text-white">Codice</a>
          )}
          {item.data.paper && (
            <a href={item.data.paper} target="_blank" rel="noopener noreferrer" class="underline hover:text-white">Paper</a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
</Layout>