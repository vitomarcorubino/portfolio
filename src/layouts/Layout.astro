---
import '../styles/global.css';

interface Props {
  title: string;
  lang?: 'it' | 'en';
  description?: string;
}

const { title, lang = 'it', description = '' } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-200 flex flex-col">
    <header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/90 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 p-4">
        <a href="/" class="font-semibold">Vito Marco Rubino</a>
          <ul class="flex flex-wrap gap-6 text-sm">
            <li><a href="/#esperienza" class="hover:underline">Esperienza</a></li>
            <li><a href="/#progetti" class="hover:underline">Progetti</a></li>
            <li><a href="/posts" class="hover:underline">Post</a></li>
            <li><a href="/#contatti" class="hover:underline">Contatti</a></li>
          </ul>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 p-4">
      <slot />
    </main>

    <footer class="border-t border-slate-800 p-4 text-center text-sm text-slate-500">
      © 2026 Vito Marco Rubino
    </footer>
  </body>
</html>